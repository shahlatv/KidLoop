<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>My Profile | KidLoop</title>


    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            background: #fafafa;
            color: #333;
        }

        a {
            text-decoration: none;
            color: inherit;
        }


        /* =========================
           ACCOUNT PAGE
        ========================= */

        .account-page {
            max-width: 1200px;
            margin: 50px auto;
            padding: 0 25px;
        }


        .account-header {
            margin-bottom: 35px;
        }

        .account-header h1 {
            font-size: 32px;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .account-header p {
            color: #777;
            font-size: 14px;
        }


        /* =========================
           SUCCESS MESSAGE
        ========================= */

        .profile-success-message {

            display: none;

            margin-bottom: 25px;

            padding: 14px 18px;

            background: #edf7ed;

            border: 1px solid #c8e6c9;

            color: #287d2f;

            font-size: 13px;

        }


        /* =========================
           LAYOUT
        ========================= */

        .account-layout {

            display: grid;

            grid-template-columns: 230px 1fr;

            gap: 30px;

        }


        /* =========================
           SIDEBAR
        ========================= */

        .account-sidebar {

            background: white;

            border: 1px solid #e5e5e5;

            height: fit-content;

        }


        .account-sidebar a,
        .account-sidebar button {

            width: 100%;

            display: block;

            padding: 16px 18px;

            border: none;

            background: white;

            border-bottom: 1px solid #eee;

            text-align: left;

            font-size: 13px;

            color: #444;

            cursor: pointer;

        }


        .account-sidebar a:hover,
        .account-sidebar button:hover {

            background: #f7f7f7;

        }


        .account-sidebar .active {

            background: #222;

            color: white;

        }


        /* =========================
           CONTENT
        ========================= */

        .account-content {

            display: flex;

            flex-direction: column;

            gap: 25px;

        }


        .card {

            background: white;

            border: 1px solid #e5e5e5;

            padding: 30px;

        }


        .card-header {

            display: flex;

            justify-content: space-between;

            align-items: center;

            margin-bottom: 25px;

        }


        .card-header h2 {

            font-size: 20px;

            font-weight: 600;

        }


        .edit-link {

            font-size: 13px;

            text-decoration: underline;

        }


        /* =========================
           PROFILE INFORMATION
        ========================= */

        .profile-info {

            display: flex;

            gap: 25px;

            align-items: center;

        }


        .profile-image {

            width: 100px;

            height: 100px;

            border-radius: 50%;

            object-fit: cover;

            border: 1px solid #ddd;

        }


        .default-profile {

            width: 100px;

            height: 100px;

            border-radius: 50%;

            background: #f1f1f1;

            display: flex;

            align-items: center;

            justify-content: center;

            font-size: 40px;

            color: #999;

        }


        .profile-details h3 {

            font-size: 21px;

            margin-bottom: 10px;

        }


        .profile-details p {

            font-size: 14px;

            color: #666;

            margin-bottom: 7px;

        }


        .verified {

            color: #2e7d32;

            font-size: 12px;

            margin-top: 8px;

        }


        /* =========================
           QUICK SETTINGS
        ========================= */

        .settings-grid {

            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 20px;

        }


        .setting-box {

            border: 1px solid #e5e5e5;

            padding: 22px;

        }


        .setting-box h3 {

            font-size: 15px;

            margin-bottom: 8px;

        }


        .setting-box p {

            font-size: 13px;

            color: #777;

            margin-bottom: 15px;

        }


        .setting-box a {

            font-size: 13px;

            text-decoration: underline;

        }


        /* =========================
           ADDRESS
        ========================= */

        .address-list {

            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 20px;

        }


        .address-card {

            border: 1px solid #e5e5e5;

            padding: 20px;

        }


        .address-card h3 {

            font-size: 15px;

            margin-bottom: 12px;

        }


        .address-card p {

            font-size: 13px;

            line-height: 1.6;

            color: #666;

        }


        .address-actions {

            margin-top: 15px;

            display: flex;

            gap: 15px;

        }


        .address-actions button {

            border: none;

            background: none;

            text-decoration: underline;

            font-size: 12px;

            cursor: pointer;

        }


        .add-address {

            display: inline-block;

            margin-top: 20px;

            padding: 12px 18px;

            background: #222;

            color: white;

            font-size: 13px;

        }


        .no-address {

            color: #888;

            font-size: 13px;

        }


        /* =========================
           RESPONSIVE
        ========================= */

        @media (max-width: 800px) {

            .account-layout {

                grid-template-columns: 1fr;

            }


            .settings-grid,

            .address-list {

                grid-template-columns: 1fr;

            }

        }


        @media (max-width: 500px) {

            .account-page {

                margin: 30px auto;

                padding: 0 15px;

            }


            .card {

                padding: 20px;

            }


            .profile-info {

                flex-direction: column;

                align-items: flex-start;

            }

        }

    </style>

</head>


<body>


    <%- include("../partials/topbar") %>

    <%- include("../partials/navbar") %>


    <main class="account-page">


        <div class="account-header">

            <h1>My Account</h1>

            <p>
                Manage your profile, password and saved addresses.
            </p>

        </div>


        <!-- SUCCESS MESSAGE -->

        <div
            id="profileSuccessMessage"
            class="profile-success-message">
        </div>


        <div class="account-layout">


            <!-- =====================
                 SIDEBAR
            ====================== -->

            <aside class="account-sidebar">

                <a
                    href="/user/profile"
                    class="active">
                    My Profile
                </a>

                <a href="/user/profile/edit">
                    Edit Profile
                </a>

                <a href="/user/change-password">
                    Change Password
                </a>

                <a href="/user/change-email">
                    Change Email
                </a>

                <a href="/user/addresses">
                    My Addresses
                </a>

                <a href="/user/orders">
                    My Orders
                </a>

                <a href="/wishlist">
                    Wishlist
                </a>

                <button
                    type="button"
                    id="logoutButton">
                    Logout
                </button>

            </aside>


            <!-- =====================
                 CONTENT
            ====================== -->

            <section class="account-content">


                <!-- PROFILE CARD -->

                <div class="card">

                    <div class="card-header">

                        <h2>
                            Personal Information
                        </h2>

                        <a
                            href="/user/profile/edit"
                            class="edit-link">
                            Edit
                        </a>

                    </div>


                    <div class="profile-info">


                        <% if (user.profileImage) { %>

                            <img
                                src="<%= user.profileImage %>"
                                alt="Profile Image"
                                class="profile-image">

                        <% } else { %>

                            <div class="default-profile">
                                👤
                            </div>

                        <% } %>


                        <div class="profile-details">

                            <h3>
                                <%= user.name %>
                            </h3>

                            <p>
                                <strong>Email:</strong>
                                <%= user.email %>
                            </p>

                            <p>
                                <strong>Phone:</strong>
                                <%= user.phone || "Not added" %>
                            </p>


                            <% if (user.isVerified) { %>

                                <div class="verified">
                                    ✓ Email Verified
                                </div>

                            <% } %>

                        </div>

                    </div>

                </div>


                <!-- QUICK SETTINGS -->

                <div class="card">

                    <div class="card-header">

                        <h2>
                            Account Settings
                        </h2>

                    </div>


                    <div class="settings-grid">


                        <div class="setting-box">

                            <h3>
                                Password
                            </h3>

                            <p>
                                Keep your account secure by
                                changing your password regularly.
                            </p>

                            <a href="/user/change-password">
                                Change Password →
                            </a>

                        </div>


                        <div class="setting-box">

                            <h3>
                                Email Address
                            </h3>

                            <p>
                                Change your email address
                                using OTP verification.
                            </p>

                            <a href="/user/change-email">
                                Change Email →
                            </a>

                        </div>


                    </div>

                </div>


                <!-- ADDRESS -->

                <div class="card">

                    <div class="card-header">

                        <h2>
                            Saved Addresses
                        </h2>

                    </div>


                    <div
                        id="addressList"
                        class="address-list">

                        <p class="no-address">
                            Loading addresses...
                        </p>

                    </div>


                    <a
                        href="/user/addresses"
                        class="add-address">
                        Manage Addresses
                    </a>

                </div>


            </section>

        </div>

    </main>


    <%- include("../partials/footer") %>


    <script>


        /* =================================
           PROFILE UPDATE SUCCESS MESSAGE
        ================================= */

        const profileSuccessMessage =
            sessionStorage.getItem(
                "profileUpdateSuccess"
            );


        if (profileSuccessMessage) {

            const messageElement =
                document.getElementById(
                    "profileSuccessMessage"
                );


            messageElement.textContent =
                profileSuccessMessage;


            messageElement.style.display =
                "block";


            sessionStorage.removeItem(
                "profileUpdateSuccess"
            );

        }


        /* =================================
           LOAD ADDRESSES
        ================================= */

        async function loadAddresses() {

            const addressList =
                document.getElementById(
                    "addressList"
                );


            try {

                const response =
                    await fetch("/user/addresses");


                const data =
                    await response.json();


                if (!response.ok || !data.success) {

                    throw new Error(
                        data.message ||
                        "Unable to load addresses."
                    );

                }


                if (
                    !data.addresses ||
                    data.addresses.length === 0
                ) {

                    addressList.innerHTML = `
                        <p class="no-address">
                            No saved addresses yet.
                        </p>
                    `;

                    return;

                }


                addressList.innerHTML =
                    data.addresses
                        .map(address => {

                            return `

                                <div class="address-card">

                                    <h3>
                                        ${escapeHtml(
                                            address.addressType ||
                                            "Address"
                                        )}

                                        ${
                                            address.isDefault
                                                ? " · Default"
                                                : ""
                                        }
                                    </h3>

                                    <p>
                                        <strong>
                                            ${escapeHtml(
                                                address.fullName
                                            )}
                                        </strong>
                                        <br>

                                        ${escapeHtml(
                                            address.phone
                                        )}
                                        <br>

                                        ${escapeHtml(
                                            address.addressLine
                                        )}
                                        <br>

                                        ${escapeHtml(
                                            address.city
                                        )},
                                        ${escapeHtml(
                                            address.state
                                        )}
                                        -
                                        ${escapeHtml(
                                            address.pincode
                                        )}
                                    </p>

                                </div>

                            `;

                        })
                        .join("");


            } catch (error) {

                console.error(
                    "Address loading error:",
                    error
                );

                addressList.innerHTML = `
                    <p class="no-address">
                        Unable to load addresses.
                    </p>
                `;

            }

        }


        /* =================================
           HTML ESCAPE
        ================================= */

        function escapeHtml(value) {

            if (value === null ||
                value === undefined) {

                return "";

            }


            return String(value)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");

        }


        /* =================================
           LOGOUT
        ================================= */

        const logoutButton =
            document.getElementById(
                "logoutButton"
            );


        if (logoutButton) {

            logoutButton.addEventListener(
                "click",
                async function () {

                    const confirmed =
                        confirm(
                            "Are you sure you want to logout?"
                        );


                    if (!confirmed) {
                        return;
                    }


                    try {

                        const response =
                            await fetch(
                                "/auth/logout",
                                {
                                    method: "POST"
                                }
                            );


                        const data =
                            await response.json();


                        if (data.success) {

                            window.location.href =
                                "/auth/login";

                        } else {

                            alert(
                                data.message ||
                                "Logout failed."
                            );

                        }

                    } catch (error) {

                        console.error(error);

                        alert(
                            "Something went wrong. Please try again."
                        );

                    }

                }
            );

        }


        /* =================================
           INITIAL LOAD
        ================================= */

        loadAddresses();

    </script>


</body>
</html>