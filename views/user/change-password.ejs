<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>Change Password | KidLoop</title>

    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            background: #fafafa;
            color: #333;
        }

        a {
            text-decoration: none;
            color: inherit;
        }


        /* =========================
           PAGE
        ========================= */

        .password-page {
            max-width: 1100px;
            margin: 50px auto;
            padding: 0 25px;
        }


        .page-title {
            text-align: center;
            margin-bottom: 35px;
        }

        .page-title h1 {
            font-size: 32px;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .page-title p {
            color: #777;
            font-size: 14px;
        }


        /* =========================
           CARD
        ========================= */

        .password-card {
            max-width: 600px;
            margin: auto;
            background: white;
            border: 1px solid #e5e5e5;
            padding: 40px;
        }


        /* =========================
           MESSAGE
        ========================= */

        .message {
            display: none;
            padding: 14px 18px;
            margin-bottom: 25px;
            font-size: 13px;
        }

        .error-message {
            background: #fff0f0;
            border: 1px solid #f0b5b5;
            color: #c62828;
        }

        .success-message {
            background: #edf7ed;
            border: 1px solid #c8e6c9;
            color: #287d2f;
        }


        /* =========================
           FORM
        ========================= */

        .form-group {
            margin-bottom: 22px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            font-weight: 600;
        }


        .password-wrapper {
            position: relative;
        }


        .password-wrapper input {
            width: 100%;
            padding: 13px 45px 13px 14px;
            border: 1px solid #d5d5d5;
            font-size: 14px;
            outline: none;
        }


        .password-wrapper input:focus {
            border-color: #333;
        }


        .toggle-password {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            border: none;
            background: none;
            cursor: pointer;
            font-size: 15px;
            color: #777;
        }


        .field-error {
            display: none;
            margin-top: 6px;
            color: #d93025;
            font-size: 12px;
        }


        .password-help {
            margin-top: 7px;
            color: #888;
            font-size: 12px;
            line-height: 1.5;
        }


        /* =========================
           BUTTONS
        ========================= */

        .button-row {
            display: flex;
            gap: 15px;
            margin-top: 30px;
        }


        .btn {
            flex: 1;
            padding: 14px;
            border: none;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
        }


        .save-btn {
            background: #222;
            color: white;
        }


        .save-btn:hover {
            background: #000;
        }


        .cancel-btn {
            background: #eeeeee;
            color: #333;
        }


        .cancel-btn:hover {
            background: #ddd;
        }


        .loading {
            opacity: 0.7;
            pointer-events: none;
        }


        /* =========================
           RESPONSIVE
        ========================= */

        @media (max-width: 600px) {

            .password-page {
                margin: 30px auto;
                padding: 0 15px;
            }

            .password-card {
                padding: 25px 20px;
            }

            .page-title h1 {
                font-size: 26px;
            }

            .button-row {
                flex-direction: column;
            }

        }

    </style>

</head>


<body>


    <%- include("../partials/topbar") %>

    <%- include("../partials/navbar") %>


    <main class="password-page">


        <div class="page-title">

            <h1>
                Change Password
            </h1>

            <p>
                Keep your KidLoop account secure.
            </p>

        </div>


        <div class="password-card">


            <!-- ERROR -->

            <div
                id="errorMessage"
                class="message error-message">
            </div>


            <!-- SUCCESS -->

            <div
                id="successMessage"
                class="message success-message">
            </div>


            <form id="changePasswordForm">


                <!-- CURRENT PASSWORD -->

                <div class="form-group">

                    <label for="currentPassword">
                        Current Password
                    </label>


                    <div class="password-wrapper">

                        <input
                            type="password"
                            id="currentPassword"
                            name="currentPassword"
                            placeholder="Enter your current password"
                            autocomplete="current-password"
                        >


                        <button
                            type="button"
                            class="toggle-password"
                            data-target="currentPassword">
                            👁
                        </button>

                    </div>


                    <div
                        id="currentPasswordError"
                        class="field-error">
                    </div>

                </div>


                <!-- NEW PASSWORD -->

                <div class="form-group">

                    <label for="newPassword">
                        New Password
                    </label>


                    <div class="password-wrapper">

                        <input
                            type="password"
                            id="newPassword"
                            name="newPassword"
                            placeholder="Enter your new password"
                            autocomplete="new-password"
                        >


                        <button
                            type="button"
                            class="toggle-password"
                            data-target="newPassword">
                            👁
                        </button>

                    </div>


                    <div class="password-help">

                        Password must contain at least
                        8 characters.

                    </div>


                    <div
                        id="newPasswordError"
                        class="field-error">
                    </div>

                </div>


                <!-- CONFIRM PASSWORD -->

                <div class="form-group">

                    <label for="confirmPassword">
                        Confirm New Password
                    </label>


                    <div class="password-wrapper">

                        <input
                            type="password"
                            id="confirmPassword"
                            name="confirmPassword"
                            placeholder="Confirm your new password"
                            autocomplete="new-password"
                        >


                        <button
                            type="button"
                            class="toggle-password"
                            data-target="confirmPassword">
                            👁
                        </button>

                    </div>


                    <div
                        id="confirmPasswordError"
                        class="field-error">
                    </div>

                </div>


                <!-- BUTTONS -->

                <div class="button-row">


                    <button
                        type="button"
                        class="btn cancel-btn"
                        id="cancelButton">

                        Cancel

                    </button>


                    <button
                        type="submit"
                        class="btn save-btn"
                        id="saveButton">

                        Change Password

                    </button>


                </div>


            </form>

        </div>

    </main>


    <%- include("../partials/footer") %>


    <script>


        /* =====================================
           ELEMENTS
        ===================================== */

        const form =
            document.getElementById(
                "changePasswordForm"
            );


        const currentPassword =
            document.getElementById(
                "currentPassword"
            );


        const newPassword =
            document.getElementById(
                "newPassword"
            );


        const confirmPassword =
            document.getElementById(
                "confirmPassword"
            );


        const saveButton =
            document.getElementById(
                "saveButton"
            );


        const cancelButton =
            document.getElementById(
                "cancelButton"
            );


        const errorMessage =
            document.getElementById(
                "errorMessage"
            );


        const successMessage =
            document.getElementById(
                "successMessage"
            );


        const currentPasswordError =
            document.getElementById(
                "currentPasswordError"
            );


        const newPasswordError =
            document.getElementById(
                "newPasswordError"
            );


        const confirmPasswordError =
            document.getElementById(
                "confirmPasswordError"
            );


        /* =====================================
           PASSWORD SHOW / HIDE
        ===================================== */

        document
            .querySelectorAll(".toggle-password")
            .forEach(button => {

                button.addEventListener(
                    "click",
                    () => {

                        const targetId =
                            button.dataset.target;

                        const input =
                            document.getElementById(
                                targetId
                            );


                        if (input.type === "password") {

                            input.type = "text";

                            button.textContent =
                                "🙈";

                        } else {

                            input.type = "password";

                            button.textContent =
                                "👁";

                        }

                    }
                );

            });


        /* =====================================
           CLEAR ERRORS
        ===================================== */

        function clearErrors() {

            errorMessage.style.display =
                "none";

            successMessage.style.display =
                "none";


            currentPasswordError.style.display =
                "none";

            newPasswordError.style.display =
                "none";

            confirmPasswordError.style.display =
                "none";


            currentPasswordError.textContent =
                "";

            newPasswordError.textContent =
                "";

            confirmPasswordError.textContent =
                "";

        }


        /* =====================================
           CANCEL
        ===================================== */

        cancelButton.addEventListener(
            "click",
            () => {

                window.location.href =
                    "/user/profile";

            }
        );


        /* =====================================
           FORM SUBMIT
        ===================================== */

        form.addEventListener(
            "submit",
            async (event) => {

                event.preventDefault();


                clearErrors();


                const current =
                    currentPassword.value.trim();

                const newPass =
                    newPassword.value;

                const confirm =
                    confirmPassword.value;


                let isValid = true;


                /* CURRENT PASSWORD */

                if (!current) {

                    currentPasswordError.textContent =
                        "Current password is required.";

                    currentPasswordError.style.display =
                        "block";

                    isValid = false;

                }


                /* NEW PASSWORD */

                if (!newPass) {

                    newPasswordError.textContent =
                        "New password is required.";

                    newPasswordError.style.display =
                        "block";

                    isValid = false;

                } else if (newPass.length < 8) {

                    newPasswordError.textContent =
                        "Password must be at least 8 characters.";

                    newPasswordError.style.display =
                        "block";

                    isValid = false;

                }


                /* CONFIRM PASSWORD */

                if (!confirm) {

                    confirmPasswordError.textContent =
                        "Please confirm your new password.";

                    confirmPasswordError.style.display =
                        "block";

                    isValid = false;

                } else if (newPass !== confirm) {

                    confirmPasswordError.textContent =
                        "New passwords do not match.";

                    confirmPasswordError.style.display =
                        "block";

                    isValid = false;

                }


                /* SAME PASSWORD */

                if (
                    current &&
                    newPass &&
                    current === newPass
                ) {

                    newPasswordError.textContent =
                        "New password must be different from current password.";

                    newPasswordError.style.display =
                        "block";

                    isValid = false;

                }


                if (!isValid) {
                    return;
                }


                /* LOADING */

                saveButton.textContent =
                    "Updating...";

                saveButton.classList.add(
                    "loading"
                );


                try {

                    const response =
                        await fetch(
                            "/user/change-password",
                            {
                                method: "PUT",

                                headers: {
                                    "Content-Type":
                                        "application/json"
                                },

                                body: JSON.stringify({

                                    currentPassword:
                                        current,

                                    newPassword:
                                        newPass,

                                    confirmPassword:
                                        confirm

                                })

                            }
                        );


                    const data =
                        await response.json();


                    if (
                        !response.ok ||
                        !data.success
                    ) {

                        throw new Error(
                            data.message ||
                            "Unable to change password."
                        );

                    }


                    /* SUCCESS */

                    successMessage.textContent =
                        "Password changed successfully.";

                    successMessage.style.display =
                        "block";


                    form.reset();


                    saveButton.textContent =
                        "Password Changed";


                    /*
                     * Return to profile after
                     * showing the success message.
                     */

                    setTimeout(
                        () => {

                            window.location.href =
                                "/user/profile";

                        },
                        1500
                    );


                } catch (error) {

                    console.error(
                        "Change password error:",
                        error
                    );


                    errorMessage.textContent =
                        error.message ||
                        "Something went wrong. Please try again.";

                    errorMessage.style.display =
                        "block";


                    saveButton.textContent =
                        "Change Password";

                    saveButton.classList.remove(
                        "loading"
                    );

                }

            }
        );

    </script>


</body>

</html>