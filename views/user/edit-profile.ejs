<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Edit Profile | KidLoop</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            background: #fafafa;
            color: #333;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        .edit-page {
            max-width: 1100px;
            margin: 50px auto;
            padding: 0 25px;
        }

        .page-title {
            text-align: center;
            margin-bottom: 35px;
        }

        .page-title h1 {
            font-size: 32px;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .page-title p {
            color: #777;
            font-size: 14px;
        }

        .edit-card {
            max-width: 700px;
            margin: auto;
            background: white;
            border: 1px solid #e5e5e5;
            padding: 40px;
        }

        .profile-image-section {
            text-align: center;
            margin-bottom: 35px;
        }

        .profile-image {
            width: 110px;
            height: 110px;
            border-radius: 50%;
            object-fit: cover;
            border: 1px solid #ddd;
            margin-bottom: 15px;
        }

        .default-profile {
            width: 110px;
            height: 110px;
            border-radius: 50%;
            background: #f2f2f2;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 15px;
            font-size: 42px;
            color: #999;
        }

        .profile-image-section p {
            font-size: 13px;
            color: #888;
        }

        .form-group {
            margin-bottom: 22px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            font-weight: 600;
        }

        .form-group input {
            width: 100%;
            padding: 13px 14px;
            border: 1px solid #d5d5d5;
            font-size: 14px;
            outline: none;
        }

        .form-group input:focus {
            border-color: #333;
        }

        .form-group input:disabled {
            background: #f5f5f5;
            color: #888;
            cursor: not-allowed;
        }

        .field-note {
            margin-top: 7px;
            font-size: 12px;
            color: #888;
        }

        .error-message {
            color: #d93025;
            font-size: 12px;
            margin-top: 6px;
            display: none;
        }

        .success-message {
            display: none;
            margin-bottom: 25px;
            padding: 14px 18px;
            background: #edf7ed;
            border: 1px solid #c8e6c9;
            color: #287d2f;
            font-size: 13px;
        }

        .general-error {
            display: none;
            margin-bottom: 25px;
            padding: 14px 18px;
            background: #fff0f0;
            border: 1px solid #f0b5b5;
            color: #c62828;
            font-size: 13px;
        }

        .button-row {
            display: flex;
            gap: 15px;
            margin-top: 30px;
        }

        .btn {
            flex: 1;
            padding: 14px;
            border: none;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
        }

        .save-btn {
            background: #222;
            color: white;
        }

        .save-btn:hover {
            background: #000;
        }

        .cancel-btn {
            background: #eeeeee;
            color: #333;
        }

        .cancel-btn:hover {
            background: #ddd;
        }

        .loading {
            opacity: 0.7;
            pointer-events: none;
        }

        @media (max-width: 600px) {
            .edit-page {
                margin: 30px auto;
                padding: 0 15px;
            }

            .edit-card {
                padding: 25px 20px;
            }

            .page-title h1 {
                font-size: 26px;
            }

            .button-row {
                flex-direction: column;
            }
        }
    </style>
</head>

<body>

    <%- include("../partials/topbar") %>
    <%- include("../partials/navbar") %>


    <main class="edit-page">

        <div class="page-title">
            <h1>Edit Profile</h1>
            <p>Update your personal information</p>
        </div>


        <div class="edit-card">

            <div
                id="generalError"
                class="general-error">
            </div>


            <div
                id="successMessage"
                class="success-message">
            </div>


            <!-- PROFILE IMAGE -->

            <div class="profile-image-section">

                <% if (user.profileImage) { %>

                    <img
                        id="profileImagePreview"
                        class="profile-image"
                        src="<%= user.profileImage %>"
                        alt="Profile Image">

                <% } else { %>

                    <div
                        id="defaultProfile"
                        class="default-profile">
                        👤
                    </div>

                    <img
                        id="profileImagePreview"
                        class="profile-image"
                        style="display:none;"
                        src=""
                        alt="Profile Image">

                <% } %>

                <p>Profile image preview</p>

            </div>


            <!-- FORM -->

            <form id="editProfileForm">


                <!-- NAME -->

                <div class="form-group">

                    <label for="name">
                        Full Name
                    </label>

                    <input
                        type="text"
                        id="name"
                        name="name"
                        value="<%= user.name %>"
                        autocomplete="name">

                    <div
                        id="nameError"
                        class="error-message">
                    </div>

                </div>


                <!-- EMAIL -->

                <div class="form-group">

                    <label for="email">
                        Email Address
                    </label>

                    <input
                        type="email"
                        id="email"
                        value="<%= user.email %>"
                        disabled>

                    <div class="field-note">
                        To change your email address, use the
                        <strong>Change Email</strong> option.
                    </div>

                </div>


                <!-- PHONE -->

                <div class="form-group">

                    <label for="phone">
                        Phone Number
                    </label>

                    <input
                        type="tel"
                        id="phone"
                        name="phone"
                        value="<%= user.phone || '' %>"
                        maxlength="10"
                        autocomplete="tel">

                    <div
                        id="phoneError"
                        class="error-message">
                    </div>

                </div>


                <!-- PROFILE IMAGE URL -->

                <div class="form-group">

                    <label for="profileImage">
                        Profile Image URL
                    </label>

                    <input
                        type="text"
                        id="profileImage"
                        name="profileImage"
                        value="<%= user.profileImage || '' %>"
                        placeholder="Enter image URL">

                    <div class="field-note">
                        Enter a valid image URL to update your profile picture.
                    </div>

                    <div
                        id="imageError"
                        class="error-message">
                    </div>

                </div>


                <!-- BUTTONS -->

                <div class="button-row">

                    <button
                        type="button"
                        class="btn cancel-btn"
                        id="cancelBtn">
                        Cancel
                    </button>

                    <button
                        type="submit"
                        class="btn save-btn"
                        id="saveBtn">
                        Save Changes
                    </button>

                </div>

            </form>

        </div>

    </main>


    <%- include("../partials/footer") %>


    <script>

        const form =
            document.getElementById("editProfileForm");

        const nameInput =
            document.getElementById("name");

        const phoneInput =
            document.getElementById("phone");

        const imageInput =
            document.getElementById("profileImage");

        const saveBtn =
            document.getElementById("saveBtn");

        const cancelBtn =
            document.getElementById("cancelBtn");

        const nameError =
            document.getElementById("nameError");

        const phoneError =
            document.getElementById("phoneError");

        const imageError =
            document.getElementById("imageError");

        const generalError =
            document.getElementById("generalError");

        const successMessage =
            document.getElementById("successMessage");

        const profileImagePreview =
            document.getElementById("profileImagePreview");

        const defaultProfile =
            document.getElementById("defaultProfile");


        /* --------------------------------
           SHOW ERROR
        -------------------------------- */

        function showError(element, message) {

            element.textContent = message;
            element.style.display = "block";

        }


        /* --------------------------------
           CLEAR ERRORS
        -------------------------------- */

        function clearErrors() {

            nameError.style.display = "none";
            phoneError.style.display = "none";
            imageError.style.display = "none";
            generalError.style.display = "none";

            nameError.textContent = "";
            phoneError.textContent = "";
            imageError.textContent = "";
            generalError.textContent = "";

        }


        /* --------------------------------
           IMAGE PREVIEW
        -------------------------------- */

        imageInput.addEventListener("input", function () {

            const imageUrl =
                imageInput.value.trim();

            if (!imageUrl) {

                profileImagePreview.style.display = "none";

                if (defaultProfile) {
                    defaultProfile.style.display = "flex";
                }

                return;
            }

            profileImagePreview.src = imageUrl;

            profileImagePreview.style.display = "block";

            if (defaultProfile) {
                defaultProfile.style.display = "none";
            }

        });


        /* --------------------------------
           IMAGE ERROR
        -------------------------------- */

        profileImagePreview.addEventListener(
            "error",
            function () {

                profileImagePreview.style.display = "none";

                if (defaultProfile) {
                    defaultProfile.style.display = "flex";
                }

                showError(
                    imageError,
                    "Unable to load this image URL."
                );

            }
        );


        /* --------------------------------
           CANCEL
        -------------------------------- */

        cancelBtn.addEventListener(
            "click",
            function () {

                window.location.href =
                    "/user/profile";

            }
        );


        /* --------------------------------
           FORM SUBMIT
        -------------------------------- */

        form.addEventListener(
            "submit",
            async function (event) {

                event.preventDefault();

                clearErrors();

                const name =
                    nameInput.value.trim();

                const phone =
                    phoneInput.value.trim();

                const profileImage =
                    imageInput.value.trim();


                let isValid = true;


                /* NAME VALIDATION */

                if (!name) {

                    showError(
                        nameError,
                        "Name is required."
                    );

                    isValid = false;

                } else if (name.length < 2) {

                    showError(
                        nameError,
                        "Name must contain at least 2 characters."
                    );

                    isValid = false;

                } else if (name.length > 50) {

                    showError(
                        nameError,
                        "Name cannot exceed 50 characters."
                    );

                    isValid = false;

                } else if (
                    !/^[A-Za-z]+(?:[ '.-][A-Za-z]+)*$/.test(name)
                ) {

                    showError(
                        nameError,
                        "Please enter a valid name."
                    );

                    isValid = false;

                }


                /* PHONE VALIDATION */

                if (phone) {

                    if (!/^[6-9]\d{9}$/.test(phone)) {

                        showError(
                            phoneError,
                            "Enter a valid 10-digit Indian phone number."
                        );

                        isValid = false;

                    }

                }


                if (!isValid) {
                    return;
                }


                /* LOADING */

                saveBtn.textContent =
                    "Saving...";

                saveBtn.classList.add("loading");


                try {

                    const response =
                        await fetch("/user/profile", {

                            method: "PUT",

                            headers: {
                                "Content-Type": "application/json"
                            },

                            body: JSON.stringify({
                                name,
                                phone,
                                profileImage
                            })

                        });


                    const data =
                        await response.json();


                    if (!response.ok || !data.success) {

                        throw new Error(
                            data.message ||
                            "Unable to update profile."
                        );

                    }


                    /*
                       Store success message before
                       redirecting to profile page.
                    */

                    sessionStorage.setItem(
                        "profileUpdateSuccess",
                        "Profile updated successfully."
                    );


                    /*
                       Redirect to profile page.
                    */

                    window.location.href =
                        "/user/profile";


                } catch (error) {

                    console.error(
                        "Profile update error:",
                        error
                    );

                    generalError.textContent =
                        error.message ||
                        "Something went wrong. Please try again.";

                    generalError.style.display =
                        "block";

                    saveBtn.textContent =
                        "Save Changes";

                    saveBtn.classList.remove(
                        "loading"
                    );

                }

            }
        );

    </script>

</body>
</html>