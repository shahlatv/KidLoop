<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>Change Email | KidLoop</title>


    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }


        body {
            font-family: Arial, sans-serif;
            background: #fafafa;
            color: #333;
        }


        a {
            text-decoration: none;
            color: inherit;
        }


        /* =========================
           PAGE
        ========================= */

        .email-page {
            max-width: 1100px;
            margin: 50px auto;
            padding: 0 25px;
        }


        .page-title {
            text-align: center;
            margin-bottom: 35px;
        }


        .page-title h1 {
            font-size: 32px;
            font-weight: 600;
            margin-bottom: 8px;
        }


        .page-title p {
            color: #777;
            font-size: 14px;
        }


        /* =========================
           CARD
        ========================= */

        .email-card {
            max-width: 600px;
            margin: auto;
            background: white;
            border: 1px solid #e5e5e5;
            padding: 40px;
        }


        /* =========================
           MESSAGE
        ========================= */

        .message {
            display: none;
            padding: 14px 18px;
            margin-bottom: 25px;
            font-size: 13px;
        }


        .error-message {
            background: #fff0f0;
            border: 1px solid #f0b5b5;
            color: #c62828;
        }


        .success-message {
            background: #edf7ed;
            border: 1px solid #c8e6c9;
            color: #287d2f;
        }


        /* =========================
           FORM
        ========================= */

        .form-group {
            margin-bottom: 22px;
        }


        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            font-weight: 600;
        }


        .form-group input {
            width: 100%;
            padding: 13px 14px;
            border: 1px solid #d5d5d5;
            font-size: 14px;
            outline: none;
        }


        .form-group input:focus {
            border-color: #333;
        }


        .field-note {
            margin-top: 7px;
            color: #888;
            font-size: 12px;
            line-height: 1.5;
        }


        .field-error {
            display: none;
            margin-top: 6px;
            color: #d93025;
            font-size: 12px;
        }


        /* =========================
           OTP SECTION
        ========================= */

        .otp-section {
            display: none;
            margin-top: 30px;
            padding-top: 30px;
            border-top: 1px solid #eeeeee;
        }


        .otp-section h2 {
            font-size: 18px;
            margin-bottom: 8px;
        }


        .otp-description {
            color: #777;
            font-size: 13px;
            line-height: 1.6;
            margin-bottom: 22px;
        }


        .otp-inputs {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin: 20px 0;
        }


        .otp-input {
            width: 45px;
            height: 50px;
            border: 1px solid #d5d5d5;
            text-align: center;
            font-size: 20px;
            outline: none;
        }


        .otp-input:focus {
            border-color: #333;
        }


        .timer {
            text-align: center;
            color: #777;
            font-size: 12px;
            margin-bottom: 12px;
        }


        .timer span {
            font-weight: 600;
            color: #333;
        }


        /* =========================
           BUTTONS
        ========================= */

        .button {
            width: 100%;
            padding: 14px;
            border: none;
            cursor: pointer;
            font-size: 13px;
            font-weight: 600;
        }


        .primary-button {
            background: #222;
            color: white;
        }


        .primary-button:hover {
            background: #000;
        }


        .secondary-button {
            margin-top: 12px;
            background: #eeeeee;
            color: #333;
        }


        .secondary-button:hover {
            background: #ddd;
        }


        .resend-button {
            display: block;
            margin: 0 auto 20px;
            border: none;
            background: none;
            text-decoration: underline;
            cursor: pointer;
            font-size: 12px;
            color: #333;
        }


        .resend-button:disabled {
            color: #aaa;
            cursor: not-allowed;
            text-decoration: none;
        }


        .loading {
            opacity: 0.7;
            pointer-events: none;
        }


        /* =========================
           RESPONSIVE
        ========================= */

        @media (max-width: 600px) {

            .email-page {
                margin: 30px auto;
                padding: 0 15px;
            }


            .email-card {
                padding: 25px 20px;
            }


            .page-title h1 {
                font-size: 26px;
            }


            .otp-inputs {
                gap: 6px;
            }


            .otp-input {
                width: 40px;
                height: 46px;
            }

        }

    </style>

</head>


<body>


    <%- include("../partials/topbar") %>

    <%- include("../partials/navbar") %>


    <main class="email-page">


        <div class="page-title">

            <h1>
                Change Email
            </h1>

            <p>
                Update your email address securely using OTP verification.
            </p>

        </div>


        <div class="email-card">


            <!-- ERROR -->

            <div
                id="errorMessage"
                class="message error-message">
            </div>


            <!-- SUCCESS -->

            <div
                id="successMessage"
                class="message success-message">
            </div>


            <!-- =========================
                 NEW EMAIL
            ========================== -->

            <form id="emailForm">

                <div class="form-group">

                    <label for="newEmail">
                        New Email Address
                    </label>


                    <input
                        type="email"
                        id="newEmail"
                        placeholder="Enter your new email address"
                        autocomplete="email"
                    >


                    <div class="field-note">
                        An OTP will be sent to this email address.
                    </div>


                    <div
                        id="emailError"
                        class="field-error">
                    </div>

                </div>


                <button
                    type="submit"
                    id="sendOtpButton"
                    class="button primary-button">

                    Send OTP

                </button>

            </form>


            <!-- =========================
                 OTP SECTION
            ========================== -->

            <div
                id="otpSection"
                class="otp-section">


                <h2>
                    Verify New Email
                </h2>


                <p class="otp-description">

                    Enter the 6-digit OTP sent to:

                    <strong id="otpEmail">
                    </strong>

                </p>


                <div class="otp-inputs">

                    <input
                        type="text"
                        class="otp-input"
                        maxlength="1"
                        inputmode="numeric"
                    >

                    <input
                        type="text"
                        class="otp-input"
                        maxlength="1"
                        inputmode="numeric"
                    >

                    <input
                        type="text"
                        class="otp-input"
                        maxlength="1"
                        inputmode="numeric"
                    >

                    <input
                        type="text"
                        class="otp-input"
                        maxlength="1"
                        inputmode="numeric"
                    >

                    <input
                        type="text"
                        class="otp-input"
                        maxlength="1"
                        inputmode="numeric"
                    >

                    <input
                        type="text"
                        class="otp-input"
                        maxlength="1"
                        inputmode="numeric"
                    >

                </div>


                <p class="timer">

                    OTP expires in

                    <span id="timer">
                        60
                    </span>

                    seconds

                </p>


                <button
                    type="button"
                    id="resendButton"
                    class="resend-button"
                    disabled>

                    Resend OTP

                </button>


                <button
                    type="button"
                    id="verifyButton"
                    class="button primary-button">

                    Verify & Change Email

                </button>


                <button
                    type="button"
                    id="cancelOtpButton"
                    class="button secondary-button">

                    Cancel

                </button>


            </div>


        </div>

    </main>


    <%- include("../partials/footer") %>


    <script>


        /* =====================================
           ELEMENTS
        ===================================== */

        const emailForm =
            document.getElementById(
                "emailForm"
            );


        const newEmailInput =
            document.getElementById(
                "newEmail"
            );


        const sendOtpButton =
            document.getElementById(
                "sendOtpButton"
            );


        const otpSection =
            document.getElementById(
                "otpSection"
            );


        const otpEmail =
            document.getElementById(
                "otpEmail"
            );


        const otpInputs =
            document.querySelectorAll(
                ".otp-input"
            );


        const verifyButton =
            document.getElementById(
                "verifyButton"
            );


        const resendButton =
            document.getElementById(
                "resendButton"
            );


        const cancelOtpButton =
            document.getElementById(
                "cancelOtpButton"
            );


        const timerElement =
            document.getElementById(
                "timer"
            );


        const emailError =
            document.getElementById(
                "emailError"
            );


        const errorMessage =
            document.getElementById(
                "errorMessage"
            );


        const successMessage =
            document.getElementById(
                "successMessage"
            );


        let currentEmail = "";

        let timeLeft = 60;

        let countdown = null;


        /* =====================================
           SHOW ERROR
        ===================================== */

        function showError(message) {

            errorMessage.textContent =
                message;

            errorMessage.style.display =
                "block";

        }


        /* =====================================
           SHOW SUCCESS
        ===================================== */

        function showSuccess(message) {

            successMessage.textContent =
                message;

            successMessage.style.display =
                "block";

        }


        /* =====================================
           CLEAR MESSAGES
        ===================================== */

        function clearMessages() {

            errorMessage.textContent =
                "";

            errorMessage.style.display =
                "none";


            successMessage.textContent =
                "";

            successMessage.style.display =
                "none";


            emailError.textContent =
                "";

            emailError.style.display =
                "none";

        }


        /* =====================================
           OTP INPUT BEHAVIOUR
        ===================================== */

        otpInputs.forEach(
            (input, index) => {

                input.addEventListener(
                    "input",
                    () => {

                        input.value =
                            input.value.replace(
                                /\D/g,
                                ""
                            );


                        if (
                            input.value &&
                            index <
                                otpInputs.length - 1
                        ) {

                            otpInputs[
                                index + 1
                            ].focus();

                        }

                    }
                );


                input.addEventListener(
                    "keydown",
                    event => {

                        if (
                            event.key ===
                                "Backspace" &&
                            !input.value &&
                            index > 0
                        ) {

                            otpInputs[
                                index - 1
                            ].focus();

                        }

                    }
                );

            }
        );


        /* =====================================
           START TIMER
        ===================================== */

        function startTimer() {

            if (countdown) {

                clearInterval(
                    countdown
                );

            }


            timeLeft = 60;

            timerElement.textContent =
                timeLeft;

            resendButton.disabled =
                true;


            countdown =
                setInterval(
                    () => {

                        timeLeft--;

                        timerElement.textContent =
                            timeLeft;


                        if (timeLeft <= 0) {

                            clearInterval(
                                countdown
                            );

                            resendButton.disabled =
                                false;

                        }

                    },
                    1000
                );

        }


        /* =====================================
           SEND OTP
        ===================================== */

        emailForm.addEventListener(
            "submit",
            async event => {

                event.preventDefault();

                clearMessages();


                const newEmail =
                    newEmailInput.value
                        .trim()
                        .toLowerCase();


                /* EMAIL VALIDATION */

                if (!newEmail) {

                    emailError.textContent =
                        "New email is required.";

                    emailError.style.display =
                        "block";

                    return;

                }


                if (
                    !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(
                        newEmail
                    )
                ) {

                    emailError.textContent =
                        "Enter a valid email address.";

                    emailError.style.display =
                        "block";

                    return;

                }


                currentEmail =
                    newEmail;


                sendOtpButton.textContent =
                    "Sending OTP...";

                sendOtpButton.classList.add(
                    "loading"
                );


                try {

                    const response =
                        await fetch(
                            "/user/change-email",
                            {
                                method: "PUT",

                                headers: {
                                    "Content-Type":
                                        "application/json"
                                },

                                body: JSON.stringify({
                                    newEmail
                                })

                            }
                        );


                    const data =
                        await response.json();


                    if (
                        !response.ok ||
                        !data.success
                    ) {

                        throw new Error(
                            data.message ||
                            "Unable to send OTP."
                        );

                    }


                    /*
                     * Show OTP section.
                     */

                    otpEmail.textContent =
                        currentEmail;

                    otpSection.style.display =
                        "block";


                    emailForm.style.display =
                        "none";


                    showSuccess(
                        "OTP sent successfully to your new email."
                    );


                    startTimer();


                    otpInputs[0].focus();


                } catch (error) {

                    console.error(
                        "Change email error:",
                        error
                    );


                    showError(
                        error.message ||
                        "Something went wrong. Please try again."
                    );


                    sendOtpButton.textContent =
                        "Send OTP";

                    sendOtpButton.classList.remove(
                        "loading"
                    );

                }

            }
        );


        /* =====================================
           VERIFY OTP
        ===================================== */

        verifyButton.addEventListener(
            "click",
            async () => {

                clearMessages();


                const otp =
                    Array.from(otpInputs)
                        .map(input => input.value)
                        .join("");


                if (otp.length !== 6) {

                    showError(
                        "Please enter the complete 6-digit OTP."
                    );

                    return;

                }


                verifyButton.textContent =
                    "Verifying...";

                verifyButton.classList.add(
                    "loading"
                );


                try {

                    const response =
                        await fetch(
                            "/user/verify-email-otp",
                            {
                                method: "PUT",

                                headers: {
                                    "Content-Type":
                                        "application/json"
                                },

                                body: JSON.stringify({
                                    otp
                                })

                            }
                        );


                    const data =
                        await response.json();


                    if (
                        !response.ok ||
                        !data.success
                    ) {

                        throw new Error(
                            data.message ||
                            "Invalid OTP."
                        );

                    }


                    if (countdown) {

                        clearInterval(
                            countdown
                        );

                    }


                    /*
                     * Store message so it can be
                     * displayed on the profile page.
                     */

                    sessionStorage.setItem(
                        "emailChangeSuccess",
                        "Email changed successfully."
                    );


                    window.location.href =
                        "/user/profile";


                } catch (error) {

                    console.error(
                        "Email OTP verification error:",
                        error
                    );


                    showError(
                        error.message ||
                        "Something went wrong. Please try again."
                    );


                    verifyButton.textContent =
                        "Verify & Change Email";

                    verifyButton.classList.remove(
                        "loading"
                    );

                }

            }
        );


        /* =====================================
           RESEND OTP
        ===================================== */

        resendButton.addEventListener(
            "click",
            async () => {

                clearMessages();


                resendButton.disabled =
                    true;


                try {

                    const response =
                        await fetch(
                            "/auth/resend-otp",
                            {
                                method: "POST",

                                headers: {
                                    "Content-Type":
                                        "application/json"
                                },

                                body: JSON.stringify({

                                    email:
                                        currentEmail,

                                    purpose:
                                        "email-change"

                                })

                            }
                        );


                    const data =
                        await response.json();


                    if (
                        !response.ok ||
                        !data.success
                    ) {

                        throw new Error(
                            data.message ||
                            "Unable to resend OTP."
                        );

                    }


                    showSuccess(
                        "A new OTP has been sent."
                    );


                    otpInputs.forEach(
                        input => {
                            input.value = "";
                        }
                    );


                    otpInputs[0].focus();


                    startTimer();


                } catch (error) {

                    console.error(
                        "Resend email OTP error:",
                        error
                    );


                    showError(
                        error.message ||
                        "Unable to resend OTP."
                    );


                    resendButton.disabled =
                        false;

                }

            }
        );


        /* =====================================
           CANCEL OTP
        ===================================== */

        cancelOtpButton.addEventListener(
            "click",
            () => {

                if (countdown) {

                    clearInterval(
                        countdown
                    );

                }


                window.location.href =
                    "/user/profile";

            }
        );

    </script>


</body>

</html>