<div class="topbar">

    <div class="topbar-left">

        <a href="/user/help">
            Help & Support
        </a>

        <a href="/user/orders">
            Track Order
        </a>

        <a href="/user/returns">
            Returns & Refunds
        </a>

    </div>


    <div class="topbar-right">

        <% if (currentUser) { %>

            <span class="welcome-user">
                Welcome, <%= currentUser.name %>
            </span>

            <span class="topbar-divider">|</span>

            <a href="/user/profile">
                My Account
            </a>

            <span class="topbar-divider">|</span>

            <button
                type="button"
                id="topbarLogout"
                class="logout-link"
            >
                Logout
            </button>

        <% } else { %>

            <a href="/auth/signup">
                Sign Up
            </a>

            <span class="topbar-divider">|</span>

            <a href="/auth/login">
                Sign In
            </a>

        <% } %>

    </div>

</div>


<style>

    .topbar {
        width: 100%;

        min-height: 34px;

        padding: 0 5%;

        display: flex;

        justify-content: space-between;

        align-items: center;

        background: #f7f5f2;

        font-size: 12px;

        color: #555;
    }


    .topbar-left,
    .topbar-right {
        display: flex;

        align-items: center;

        gap: 20px;
    }


    .topbar a {
        color: #555;

        text-decoration: none;

        transition: color 0.2s ease;
    }


    .topbar a:hover {
        color: #111;
    }


    .welcome-user {
        color: #444;

        font-weight: 500;
    }


    .topbar-divider {
        color: #ccc;
    }


    .logout-link {
        border: none;

        background: none;

        padding: 0;

        color: #555;

        font-family: inherit;

        font-size: 12px;

        cursor: pointer;
    }


    .logout-link:hover {
        color: #111;
    }


    @media (max-width: 600px) {

        .topbar {
            padding: 8px 4%;

            font-size: 10px;
        }


        .topbar-left {
            display: none;
        }


        .topbar-right {
            width: 100%;

            justify-content: flex-end;

            gap: 10px;
        }


        .welcome-user {
            display: none;
        }

    }

</style>


<script>

    const topbarLogout =
        document.getElementById("topbarLogout");


    if (topbarLogout) {

        topbarLogout.addEventListener(
            "click",
            async () => {

                const confirmed =
                    confirm(
                        "Are you sure you want to logout?"
                    );


                if (!confirmed) {
                    return;
                }


                try {

                    const response =
                        await fetch(
                            "/auth/logout",
                            {
                                method: "POST"
                            }
                        );


                    const data =
                        await response.json();


                    if (data.success) {

                        window.location.href =
                            "/auth/login";

                    } else {

                        alert(
                            data.message ||
                            "Logout failed"
                        );

                    }

                } catch (error) {

                    console.error(error);

                    alert(
                        "Something went wrong. Please try again."
                    );

                }

            }
        );

    }

</script>