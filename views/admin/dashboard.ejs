<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard | KidLoop Admin</title>
    <link rel="stylesheet" href="/css/admin/sidebar.css">
    <style>
      :root {
        --ink: #292531;
        --muted: #827b8d;
        --line: #eae4ed;
        --purple: #30243f;
        --bg: #faf8f6;
        --coral: #e98579;
        --lavender: #ede5f7;
      }
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        font-family: Inter, "Segoe UI", Arial, sans-serif;
        background: var(--bg);
        color: var(--ink);
        font-size: 13px;
      }
      .main {
        margin-left: 220px;
      }
      .topbar {
        height: 64px;
        background: white;
        border-bottom: 1px solid var(--line);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 27px;
        position: sticky;
        top: 0;
      }
      .topbar-left {
        display: flex;
        align-items: center;
        gap: 18px;
      }
      .search {
        width: 190px;
        padding: 9px 13px;
        border: 1px solid #edf0f6;
        border-radius: 20px;
        background: #fafbfe;
        font-size: 10px;
      }
      .admin {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 11px;
      }
      .avatar {
        width: 29px;
        height: 29px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: #e9edfb;
        color: #4557a5;
        font-weight: bold;
      }
      .content {
        padding: 24px 26px 35px;
        max-width: 1500px;
        margin: auto;
      }
      .welcome {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 19px;
      }
      .welcome h1 {
        font-size: 20px;
        margin-bottom: 5px;
      }
      .welcome p {
        color: var(--muted);
        font-size: 11px;
      }
      .date {
        padding: 10px 12px;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 8px;
        font-size: 10px;
        color: #687184;
      }
      .metrics {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 17px;
      }
      .metric,
      .card,
      .recent {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 12px;
        overflow: hidden;
        min-width: 0;
      }
      .metric {
        padding: 15px 13px;
      }
      .metric-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 5px;
        color: var(--muted);
        font-size: 9px;
      }
      .metric-icon {
        width: 29px;
        height: 29px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: #e8efff;
        color: #5578dc;
        font-size: 15px;
      }
      .metric-value {
        font-size: 21px;
        font-weight: 800;
        margin-top: 12px;
      }
      .metric-foot {
        font-size: 9px;
        color: #9aa1af;
        margin-top: 5px;
      }
      .two,
      .bottom {
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(260px, 0.95fr);
        gap: 12px;
        margin-bottom: 17px;
      }
      .bottom {
        grid-template-columns: 1fr 1fr;
      }
      .head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 10px;
        padding: 17px 16px 8px;
      }
      .head h2 {
        font-size: 12px;
      }
      .head p {
        font-size: 9px;
        color: var(--muted);
        margin-top: 5px;
      }
      .select {
        padding: 6px 8px;
        border: 1px solid var(--line);
        background: white;
        border-radius: 7px;
        font-size: 9px;
        color: #7c8494;
      }
      .chart {
        width: 100%;
        height: 180px;
        display: block;
        padding: 8px 10px;
      }
      .channel,
      .status-area {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 20px;
        min-height: 205px;
        padding: 15px;
      }
      .donut {
        width: 125px;
        height: 125px;
        border-radius: 50%;
        background: conic-gradient(
          #e0ad28 0 74%,
          #4b74d7 74% 87%,
          #3fc7cf 87% 95%,
          #c43e5a 95%
        );
        position: relative;
        flex-shrink: 0;
      }
      .donut:after {
        content: "";
        position: absolute;
        inset: 22px;
        background: #fff;
        border-radius: 50%;
      }
      .donut-label {
        position: absolute;
        inset: 0;
        z-index: 1;
        display: grid;
        place-content: center;
        text-align: center;
        font-size: 10px;
        font-weight: 800;
      }
      .legend {
        display: grid;
        gap: 15px;
        font-size: 10px;
        color: #4d5668;
      }
      .legend span {
        display: flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
      }
      .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
      }
      .blue {
        background: #315fcb;
      }
      .cyan {
        background: #3fc7cf;
      }
      .gold {
        background: #e0ad28;
      }
      .red {
        background: #c43e5a;
      }
      .green {
        background: #2eb56c;
      }
      .table-scroll {
        overflow-x: auto;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        min-width: 400px;
      }
      th,
      td {
        text-align: left;
        padding: 11px 10px;
        border-bottom: 1px solid #eef1f6;
        font-size: 9px;
        white-space: nowrap;
      }
      th {
        color: #a0a6b2;
        font-size: 8px;
      }
      td {
        color: #5b6474;
      }
      .empty {
        padding: 28px;
        text-align: center;
        color: #969ead;
        font-size: 10px;
      }
      .recent {
        margin-bottom: 20px;
      }
      .head a {
        font-size: 9px;
        color: var(--purple);
        font-weight: 700;
        text-decoration: none;
      }
      .toggle {
        display: none;
      }
      .overlay {
        display: none;
      }
      @media (max-width: 1050px) {
        .main {
          margin-left: 200px;
        }
        .metrics {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
        .content {
          padding: 20px 16px;
        }
      }
      @media (max-width: 760px) {
        .admin-sidebar {
          width: 245px;
          transform: translateX(-100%);
          transition: transform 0.2s ease;
        }
        .admin-sidebar.open {
          transform: translateX(0);
        }
        .overlay.show {
          display: block;
          position: fixed;
          inset: 0;
          background: #18203366;
          z-index: 4;
        }
        .main {
          margin-left: 0;
        }
        .toggle {
          display: block;
          border: 0;
          background: white;
          font-size: 22px;
          cursor: pointer;
        }
        .topbar {
          padding: 0 14px;
          gap: 10px;
        }
        .topbar-left {
          gap: 10px;
        }
        .search {
          display: none;
        }
        .content {
          padding: 18px 12px;
        }
        .welcome {
          align-items: flex-start;
          flex-direction: column;
        }
        .metrics {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .two,
        .bottom {
          grid-template-columns: 1fr;
        }
        .channel,
        .status-area {
          min-height: 180px;
        }
      }
      @media (max-width: 390px) {
        .metrics {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <%- include("../partials/admin/sidebar", { activePage: "dashboard" }) %>
    <div class="overlay" id="overlay"></div>
    <div class="main">
      <header class="topbar">
        <div class="topbar-left">
          <button class="toggle" id="toggle" aria-label="Open menu">☰</button
          ><b>Dashboard</b
          ><input
            class="search"
            placeholder="⌕  Search dashboard"
            aria-label="Search dashboard"
          />
        </div>
        <div class="admin">
          <span>Admin</span><span class="avatar">A</span
          ><button
            id="logout"
            style="border: 0; background: none; cursor: pointer"
            title="Logout"
          >
            ↪
          </button>
        </div>
      </header>
      <main class="content">
        <section class="welcome">
          <div>
            <h1>Hello Admin 👋🏻,</h1>
            <p>Here's what's happening with your store.</p>
          </div>
          <div class="date">▣ &nbsp; Dashboard overview</div>
        </section>
        <section class="metrics" aria-label="Store summary">
          <article class="metric">
            <div class="metric-head">
              Total Customers <span class="metric-icon">♧</span>
            </div>
            <div class="metric-value">—</div>
            <div class="metric-foot">Customer records</div>
          </article>
          <article class="metric">
            <div class="metric-head">
              Total Orders <span class="metric-icon">▣</span>
            </div>
            <div class="metric-value">—</div>
            <div class="metric-foot">Orders recorded</div>
          </article>
          <article class="metric">
            <div class="metric-head">
              Total Revenue <span class="metric-icon">₹</span>
            </div>
            <div class="metric-value">—</div>
            <div class="metric-foot">Calculated from orders</div>
          </article>
          <article class="metric">
            <div class="metric-head">
              Active Now <span class="metric-icon">◉</span>
            </div>
            <div class="metric-value">—</div>
            <div class="metric-foot">If online activity is tracked</div>
          </article>
          <article class="metric">
            <div class="metric-head">
              Refunds <span class="metric-icon">↻</span>
            </div>
            <div class="metric-value">—</div>
            <div class="metric-foot">Refund records</div>
          </article>
        </section>
        <section class="two">
          <article class="card">
            <div class="head">
              <div>
                <h2>Sales Overview</h2>
                <p>Revenue trend over time</p>
              </div>
              <select class="select" aria-label="Sales period">
                <option>Daily</option>
                <option>Weekly</option>
                <option>Monthly</option>
              </select>
            </div>
            <svg
              class="chart"
              viewBox="0 0 500 190"
              role="img"
              aria-label="Sales chart waiting for real data"
            >
              <g stroke="#edf0f6">
                <line x1="45" y1="20" x2="485" y2="20" />
                <line x1="45" y1="55" x2="485" y2="55" />
                <line x1="45" y1="90" x2="485" y2="90" />
                <line x1="45" y1="125" x2="485" y2="125" />
                <line x1="45" y1="160" x2="485" y2="160" />
              </g>
              <g fill="#9aa2b2" font-size="10">
                <text x="7" y="23">₹ —</text>
                <text x="7" y="58">₹ —</text>
                <text x="7" y="93">₹ —</text>
                <text x="7" y="128">₹ —</text>
                <text x="7" y="163">₹ 0</text>
              </g>
              <text
                x="265"
                y="94"
                fill="#9aa2b2"
                font-size="12"
                text-anchor="middle"
              >
                Sales data will appear here
              </text>
            </svg>
          </article>
          <article class="card">
            <div class="head">
              <div>
                <h2>Sales By Channel</h2>
                <p>Order source breakdown</p>
              </div>
            </div>
            <div class="channel">
              <div class="donut" style="background: #f0f2f7">
                <div class="donut-label">No data<br />yet</div>
              </div>
              <div class="legend">
                <span><i class="dot blue"></i>Website</span
                ><span><i class="dot cyan"></i>Mobile App</span
                ><span><i class="dot gold"></i>Android App</span
                ><span><i class="dot red"></i>Others</span>
              </div>
            </div>
            <p class="empty">Channel data will be connected to the database.</p>
          </article>
        </section>
        <section class="bottom">
          <article class="card">
            <div class="head">
              <div>
                <h2>Top Selling Products</h2>
                <p>Products ranked by units sold</p>
              </div>
              <a href="/admin/products">View all</a>
            </div>
            <div class="table-scroll">
              <table>
                <thead>
                  <tr>
                    <th>No.</th>
                    <th>Image</th>
                    <th>Product name</th>
                    <th>Orders</th>
                    <th>Total amount</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td class="empty" colspan="5">
                      Product sales data will appear here
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </article>
          <article class="card">
            <div class="head">
              <div>
                <h2>Order Status</h2>
                <p>Current order distribution</p>
              </div>
            </div>
            <div class="status-area">
              <div class="donut" style="background: #f0f2f7">
                <div class="donut-label">No data<br />yet</div>
              </div>
              <div class="legend">
                <span><i class="dot green"></i>Shipped</span
                ><span><i class="dot blue"></i>Processing</span
                ><span><i class="dot red"></i>Cancelled</span
                ><span><i class="dot gold"></i>Pending</span>
              </div>
            </div>
            <p class="empty">Status totals will use actual order records.</p>
          </article>
        </section>
        <section class="recent">
          <div class="head">
            <div>
              <h2>Recent Orders</h2>
              <p>Latest customer orders</p>
            </div>
            <a href="/admin/orders">View all</a>
          </div>
          <div class="table-scroll">
            <table>
              <thead>
                <tr>
                  <th>Order ID</th>
                  <th>Customer</th>
                  <th>Date</th>
                  <th>Email</th>
                  <th>Total</th>
                  <th>Status</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="empty" colspan="7">
                    Recent orders will appear here when order data is connected.
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>
      </main>
    </div>
    <script>
     const side = document.getElementById("adminSidebar");
      const overlay = document.getElementById("overlay");
      const toggle = document.getElementById("toggle");

      if (toggle && side && overlay) {
        toggle.addEventListener("click", () => {
          side.classList.toggle("open");
          overlay.classList.toggle("show");
        });

        overlay.addEventListener("click", () => {
          side.classList.remove("open");
          overlay.classList.remove("show");
        });
      }

      document.getElementById("logout").addEventListener("click", async () => {
        if (!confirm("Are you sure you want to logout?")) return;
        try {
          const r = await fetch("/admin/logout", { method: "POST" });
          const d = await r.json();
          if (r.ok && d.success) location.replace("/admin/login");
          else alert(d.message || "Logout failed");
        } catch (e) {
          console.error(e);
          alert("Unable to logout. Please try again.");
        }
      });
    </script>
  </body>
</html>
