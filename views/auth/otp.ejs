<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>OTP Verification | KidLoop</title>

    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            font-family: Arial, Helvetica, sans-serif;
            background: #f7f7f5;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 30px;
        }

        .otp-wrapper {
            width: 100%;
            max-width: 1100px;
            min-height: 660px;
            background: #ffffff;
            display: flex;
            border: 1px solid #e5e5e5;
        }

        /* LEFT IMAGE */

        .image-section {
            width: 42%;
            background: #e6d84f;
            overflow: hidden;
        }

        .image-section img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        /* RIGHT SIDE */

        .form-section {
            width: 58%;
            display: flex;
            flex-direction: column;
            padding: 55px 70px 30px;
            position: relative;
        }

        .brand {
            font-family: Georgia, "Times New Roman", serif;
            font-size: 38px;
            color: #333333;
            text-align: center;
            margin-bottom: 110px;
        }

        .otp-container {
            width: 100%;
            max-width: 430px;
            margin: 0 auto;
            text-align: center;
        }

        .otp-container h1 {
            font-family: Georgia, "Times New Roman", serif;
            font-size: 28px;
            font-weight: 500;
            color: #333333;
            margin-bottom: 10px;
        }

        .subtitle {
            font-size: 12px;
            color: #777777;
            margin-bottom: 25px;
        }

        .email-text {
            font-size: 12px;
            color: #555555;
            margin-bottom: 20px;
        }

        /* OTP BOXES */

        .otp-inputs {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-bottom: 20px;
        }

        .otp-input {
            width: 48px;
            height: 52px;
            border: 1px solid #dedede;
            border-radius: 5px;
            text-align: center;
            font-size: 20px;
            font-weight: 500;
            outline: none;
            background: #fafafa;
        }

        .otp-input:focus {
            border-color: #333333;
            background: #ffffff;
        }

        /* TIMER */

        .timer {
            font-size: 11px;
            color: #777777;
            margin-bottom: 12px;
        }

        .timer span {
            font-weight: 600;
            color: #333333;
        }

        /* RESEND */

        .resend-text {
            font-size: 11px;
            color: #777777;
            margin-bottom: 25px;
        }

        .resend-btn {
            border: none;
            background: none;
            color: #333333;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: underline;
            padding: 0;
        }

        .resend-btn:disabled {
            color: #b5b5b5;
            cursor: not-allowed;
            text-decoration: none;
        }

        /* VERIFY BUTTON */

        .verify-btn {
            width: 100%;
            height: 45px;
            border: none;
            border-radius: 7px;
            background: #211f1b;
            color: white;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.5px;
            cursor: pointer;
            transition: 0.2s;
        }

        .verify-btn:hover {
            background: #000000;
        }

        .verify-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        /* MESSAGE */

        .message {
            min-height: 20px;
            margin-top: 15px;
            font-size: 12px;
        }

        .error {
            color: #c62828;
        }

        .success {
            color: #2e7d32;
        }

        /* BACK TO LOGIN */

        .back-login {
            display: inline-block;
            margin-top: 25px;
            color: #999999;
            text-decoration: none;
            font-size: 10px;
        }

        .back-login:hover {
            color: #333333;
        }

        /* FOOTER */

        .terms {
            margin-top: auto;
            text-align: right;
            font-size: 9px;
            color: #999999;
        }

        /* RESPONSIVE */

        @media (max-width: 800px) {

            body {
                padding: 15px;
            }

            .otp-wrapper {
                min-height: auto;
                flex-direction: column;
            }

            .image-section {
                width: 100%;
                height: 280px;
            }

            .form-section {
                width: 100%;
                padding: 40px 25px 25px;
            }

            .brand {
                margin-bottom: 50px;
            }

            .terms {
                margin-top: 50px;
            }

        }

        @media (max-width: 450px) {

            .image-section {
                height: 220px;
            }

            .form-section {
                padding: 35px 18px 20px;
            }

            .brand {
                font-size: 32px;
                margin-bottom: 45px;
            }

            .otp-inputs {
                gap: 6px;
            }

            .otp-input {
                width: 42px;
                height: 48px;
            }

        }

    </style>

</head>


<body>

    <div class="otp-wrapper">


        <!-- LEFT IMAGE -->

        <div class="image-section">

            <img
                src="/images/otp-verification.jpg"
                alt="KidLoop Kids"
            >

        </div>


        <!-- RIGHT CONTENT -->

        <div class="form-section">


            <div class="brand">
                KidLoop
            </div>


            <div class="otp-container">


                <h1>
                    Verify OTP
                </h1>


                <p class="subtitle">
                    We sent a code to your email
                </p>


                <% if (email) { %>

                    <p class="email-text">
                        <%= email %>
                    </p>

                <% } %>


                <!-- OTP INPUTS -->

                <div class="otp-inputs">

                    <input
                        type="text"
                        class="otp-input"
                        maxlength="1"
                        inputmode="numeric"
                    >

                    <input
                        type="text"
                        class="otp-input"
                        maxlength="1"
                        inputmode="numeric"
                    >

                    <input
                        type="text"
                        class="otp-input"
                        maxlength="1"
                        inputmode="numeric"
                    >

                    <input
                        type="text"
                        class="otp-input"
                        maxlength="1"
                        inputmode="numeric"
                    >

                    <input
                        type="text"
                        class="otp-input"
                        maxlength="1"
                        inputmode="numeric"
                    >

                    <input
                        type="text"
                        class="otp-input"
                        maxlength="1"
                        inputmode="numeric"
                    >

                </div>


                <!-- TIMER -->

                <p class="timer">

                    OTP expires in

                    <span id="timer">
                        60
                    </span>

                    seconds

                </p>


                <!-- RESEND -->

                <p class="resend-text">

                    Didn't receive the OTP?

                    <button
                        type="button"
                        id="resendBtn"
                        class="resend-btn"
                        disabled
                    >
                        Resend code
                    </button>

                </p>


                <!-- VERIFY -->

                <button
                    type="button"
                    id="verifyBtn"
                    class="verify-btn"
                >
                    VERIFY
                </button>


                <!-- MESSAGE -->

                <p
                    id="message"
                    class="message"
                ></p>


                <!-- BACK -->

                <a
                    href="/auth/login"
                    class="back-login"
                >
                    ← Back to Login
                </a>


            </div>


            <div class="terms">
                Terms & Conditions
            </div>


        </div>

    </div>


    <script>

        const email = "<%= email %>";


        const otpInputs =
            document.querySelectorAll(".otp-input");


        const verifyBtn =
            document.getElementById("verifyBtn");


        const resendBtn =
            document.getElementById("resendBtn");


        const timerElement =
            document.getElementById("timer");


        const message =
            document.getElementById("message");


        let timeLeft = 60;


        /* =====================================
           OTP INPUT BEHAVIOUR
        ===================================== */

        otpInputs.forEach((input, index) => {

            input.addEventListener(
                "input",
                () => {

                    input.value =
                        input.value.replace(/\D/g, "");


                    if (
                        input.value &&
                        index < otpInputs.length - 1
                    ) {

                        otpInputs[index + 1].focus();

                    }

                }
            );


            input.addEventListener(
                "keydown",
                (event) => {

                    if (
                        event.key === "Backspace" &&
                        !input.value &&
                        index > 0
                    ) {

                        otpInputs[index - 1].focus();

                    }

                }
            );

        });


        /* =====================================
           TIMER
        ===================================== */

        const countdown =
            setInterval(
                () => {

                    timeLeft--;

                    timerElement.textContent =
                        timeLeft;


                    if (timeLeft <= 0) {

                        clearInterval(countdown);

                        timerElement.textContent =
                            "0";

                        resendBtn.disabled =
                            false;

                    }

                },
                1000
            );


        /* =====================================
           VERIFY OTP
        ===================================== */

        verifyBtn.addEventListener(
            "click",
            async () => {

                const otp =
                    Array.from(otpInputs)
                        .map(input => input.value)
                        .join("");


                message.textContent =
                    "";

                message.className =
                    "message";


                if (otp.length !== 6) {

                    message.textContent =
                        "Please enter the complete 6-digit OTP.";

                    message.classList.add(
                        "error"
                    );

                    return;

                }


                verifyBtn.disabled =
                    true;


                try {

                    const response =
                        await fetch(
                            "/auth/verify-otp",
                            {
                                method: "POST",

                                headers: {
                                    "Content-Type":
                                        "application/json"
                                },

                                body: JSON.stringify({
                                    email,
                                    otp
                                })
                            }
                        );


                    const data =
                        await response.json();


                    if (!data.success) {

                        message.textContent =
                            data.message ||
                            "Invalid OTP.";

                        message.classList.add(
                            "error"
                        );

                        verifyBtn.disabled =
                            false;

                        return;

                    }


                    message.textContent =
                        "Signup successful! Redirecting...";

                    message.classList.add(
                        "success"
                    );


                    /*
                     * IMPORTANT:
                     *
                     * The server has already created
                     * the user session:
                     *
                     * req.session.userId = user._id
                     *
                     * Therefore we can directly
                     * send the user to Home.
                     */

                    setTimeout(
                        () => {

                            window.location.href =
                                "/";

                        },
                        1000
                    );


                } catch (error) {

                    console.error(
                        "OTP verification error:",
                        error
                    );


                    message.textContent =
                        "Something went wrong. Please try again.";

                    message.classList.add(
                        "error"
                    );


                    verifyBtn.disabled =
                        false;

                }

            }
        );


        /* =====================================
           RESEND OTP
        ===================================== */

        resendBtn.addEventListener(
            "click",
            async () => {

                if (!email) {

                    message.textContent =
                        "Signup session expired. Please signup again.";

                    message.classList.add(
                        "error"
                    );

                    return;

                }


                resendBtn.disabled =
                    true;


                message.textContent =
                    "";

                message.className =
                    "message";


                try {

                    const response =
                        await fetch(
                            "/auth/resend-otp",
                            {
                                method: "POST",

                                headers: {
                                    "Content-Type":
                                        "application/json"
                                },

                                body: JSON.stringify({

                                    email,

                                    purpose: "signup"

                                })

                            }
                        );


                    const data =
                        await response.json();


                    if (!data.success) {

                        message.textContent =
                            data.message ||
                            "Unable to resend OTP.";

                        message.classList.add(
                            "error"
                        );

                        resendBtn.disabled =
                            false;

                        return;

                    }


                    message.textContent =
                        "A new OTP has been sent to your email.";

                    message.classList.add(
                        "success"
                    );


                    /* RESET TIMER */

                    timeLeft = 60;

                    timerElement.textContent =
                        timeLeft;


                    const newCountdown =
                        setInterval(
                            () => {

                                timeLeft--;

                                timerElement.textContent =
                                    timeLeft;


                                if (timeLeft <= 0) {

                                    clearInterval(
                                        newCountdown
                                    );

                                    resendBtn.disabled =
                                        false;

                                }

                            },
                            1000
                        );


                    otpInputs.forEach(
                        input => {
                            input.value = "";
                        }
                    );


                    otpInputs[0].focus();


                } catch (error) {

                    console.error(
                        "Resend OTP error:",
                        error
                    );


                    message.textContent =
                        "Something went wrong. Please try again.";

                    message.classList.add(
                        "error"
                    );


                    resendBtn.disabled =
                        false;

                }

            }
        );

    </script>

</body>
</html>