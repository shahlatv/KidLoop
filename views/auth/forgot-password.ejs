<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Forgot Password | KidLoop</title>


    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }


        body {
            min-height: 100vh;
            font-family: Arial, Helvetica, sans-serif;
            background: #f7f7f5;

            display: flex;
            justify-content: center;
            align-items: center;

            padding: 30px;
        }


        .forgot-wrapper {
            width: 100%;
            max-width: 1100px;
            min-height: 660px;

            background: #ffffff;

            display: flex;

            border: 1px solid #e5e5e5;
        }


        /* IMAGE */

        .image-section {
            width: 42%;
            overflow: hidden;
        }


        .image-section img {
            width: 100%;
            height: 100%;

            object-fit: cover;

            display: block;
        }


        /* FORM */

        .form-section {
            width: 58%;

            display: flex;
            flex-direction: column;

            padding: 55px 70px 30px;
        }


        .brand {
            font-family: Georgia, "Times New Roman", serif;

            font-size: 38px;

            color: #333333;

            text-align: center;

            margin-bottom: 110px;
        }


        .forgot-container {
            width: 100%;
            max-width: 430px;

            margin: 0 auto;

            text-align: center;
        }


        .forgot-container h1 {
            font-family: Georgia, "Times New Roman", serif;

            font-size: 28px;

            font-weight: 500;

            color: #333333;

            margin-bottom: 10px;
        }


        .subtitle {
            font-size: 12px;

            color: #777777;

            line-height: 1.6;

            margin-bottom: 30px;
        }


        /* FIELD */

        .field {
            text-align: left;

            margin-bottom: 18px;
        }


        .field label {
            display: block;

            font-size: 11px;

            color: #444444;

            margin-bottom: 7px;
        }


        .field input {
            width: 100%;

            height: 46px;

            border: 1px solid #dddddd;

            border-radius: 5px;

            padding: 0 13px;

            font-size: 13px;

            outline: none;
        }


        .field input:focus {
            border-color: #333333;
        }


        .field-error {
            display: block;

            min-height: 16px;

            margin-top: 5px;

            font-size: 10px;

            color: #c62828;
        }


        /* BUTTON */

        .forgot-btn {
            width: 100%;

            height: 45px;

            border: none;

            border-radius: 7px;

            background: #211f1b;

            color: white;

            font-size: 11px;

            font-weight: 600;

            letter-spacing: 0.5px;

            cursor: pointer;
        }


        .forgot-btn:hover {
            background: #000000;
        }


        .forgot-btn:disabled {
            opacity: 0.6;

            cursor: not-allowed;
        }


        /* MESSAGE */

        .message {
            min-height: 20px;

            margin-top: 15px;

            font-size: 12px;
        }


        .error {
            color: #c62828;
        }


        .success {
            color: #2e7d32;
        }


        /* BACK */

        .back-login {
            display: inline-block;

            margin-top: 25px;

            color: #777777;

            font-size: 11px;

            text-decoration: none;
        }


        .back-login:hover {
            color: #333333;
        }


        /* FOOTER */

        .terms {
            margin-top: auto;

            text-align: right;

            font-size: 9px;

            color: #999999;
        }


        /* MOBILE */

        @media (max-width: 800px) {

            body {
                padding: 15px;
            }


            .forgot-wrapper {
                flex-direction: column;

                min-height: auto;
            }


            .image-section {
                width: 100%;

                height: 280px;
            }


            .form-section {
                width: 100%;

                padding: 40px 25px 25px;
            }


            .brand {
                margin-bottom: 50px;
            }


            .terms {
                margin-top: 50px;
            }

        }


        @media (max-width: 450px) {

            .image-section {
                height: 220px;
            }


            .form-section {
                padding: 35px 18px 20px;
            }


            .brand {
                font-size: 32px;

                margin-bottom: 45px;
            }

        }

    </style>

</head>


<body>


    <div class="forgot-wrapper">


        <!-- IMAGE -->

        <div class="image-section">

            <img
                src="/images/otp-verification.jpg"
                alt="KidLoop Kids"
            >

        </div>


        <!-- FORM -->

        <div class="form-section">


            <div class="brand">
                KidLoop
            </div>


            <div class="forgot-container">


                <h1>
                    Forgot Password?
                </h1>


                <p class="subtitle">

                    Enter the email address associated
                    with your KidLoop account.
                    We'll send you an OTP to reset
                    your password.

                </p>


                <form
                    id="forgotForm"
                    novalidate
                >


                    <div class="field">

                        <label for="email">
                            Email
                        </label>


                        <input
                            type="email"
                            id="email"
                            placeholder="Enter your email"
                            autocomplete="email"
                            maxlength="100"
                        >


                        <small
                            id="emailError"
                            class="field-error"
                        ></small>

                    </div>


                    <button
                        type="submit"
                        id="forgotBtn"
                        class="forgot-btn"
                    >
                        SEND OTP
                    </button>


                </form>


                <p
                    id="message"
                    class="message"
                ></p>


                <a
                    href="/auth/login"
                    class="back-login"
                >
                    ← Back to Login
                </a>


            </div>


            <div class="terms">
                Terms & Conditions
            </div>


        </div>


    </div>



    <script>


        const forgotForm =
            document.getElementById("forgotForm");


        const emailInput =
            document.getElementById("email");


        const emailError =
            document.getElementById("emailError");


        const forgotBtn =
            document.getElementById("forgotBtn");


        const message =
            document.getElementById("message");



        forgotForm.addEventListener(
            "submit",
            async (event) => {

                event.preventDefault();


                emailError.textContent = "";

                message.textContent = "";

                message.className =
                    "message";


                const email =
                    emailInput.value
                        .trim()
                        .toLowerCase();


                let isValid = true;


                /* EMAIL REQUIRED */

                if (!email) {

                    emailError.textContent =
                        "Email is required.";

                    isValid = false;

                }


                /* EMAIL FORMAT */

                else if (
                    !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(
                        email
                    )
                ) {

                    emailError.textContent =
                        "Please enter a valid email address.";

                    isValid = false;

                }


                if (!isValid) {
                    return;
                }


                forgotBtn.disabled = true;

                forgotBtn.textContent =
                    "SENDING...";


                try {

                    const response =
                        await fetch(
                            "/auth/forgot-password",
                            {
                                method: "POST",

                                headers: {
                                    "Content-Type":
                                        "application/json"
                                },

                                body: JSON.stringify({
                                    email
                                })
                            }
                        );


                    const data =
                        await response.json();


                    if (!data.success) {

                        message.textContent =
                            data.message ||
                            "Unable to process request.";

                        message.classList.add(
                            "error"
                        );

                        forgotBtn.disabled = false;

                        forgotBtn.textContent =
                            "SEND OTP";

                        return;
                    }


                    /*
                        Store email so the
                        forgot-password OTP page
                        knows which account is
                        being verified.
                    */

                    sessionStorage.setItem(
                        "forgotPasswordEmail",
                        email
                    );


                    message.textContent =
                        "OTP sent successfully.";

                    message.classList.add(
                        "success"
                    );


                    /*
                        Move to the forgot-password
                        OTP verification page.
                    */

                    setTimeout(() => {

                        window.location.href =
                            "/auth/forgot-password/otp";

                    }, 500);


                } catch (error) {

                    message.textContent =
                        "Something went wrong. Please try again.";

                    message.classList.add(
                        "error"
                    );

                    forgotBtn.disabled = false;

                    forgotBtn.textContent =
                        "SEND OTP";

                }

            }
        );

    </script>


</body>

</html>