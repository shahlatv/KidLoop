<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Reset Password | KidLoop</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }

        body {
            min-height: 100vh;
            background: #fdf9f5;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .container {
            width: 100%;
            max-width: 1000px;
            min-height: 600px;
            background: white;
            border-radius: 24px;
            overflow: hidden;
            display: flex;
            box-shadow: 0 10px 35px rgba(0, 0, 0, 0.08);
        }

        .image-section {
            width: 50%;
            background: #f5e8df;
        }

        .image-section img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .form-section {
            width: 50%;
            padding: 55px 60px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .brand {
            font-size: 30px;
            font-weight: bold;
            color: #333;
            margin-bottom: 10px;
        }

        .title {
            font-size: 28px;
            margin-bottom: 10px;
            color: #222;
        }

        .subtitle {
            color: #777;
            font-size: 14px;
            line-height: 1.6;
            margin-bottom: 30px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            font-weight: 600;
            color: #333;
        }

        .password-wrapper {
            position: relative;
        }

        input {
            width: 100%;
            padding: 14px 45px 14px 14px;
            border: 1px solid #ddd;
            border-radius: 10px;
            outline: none;
            font-size: 14px;
            transition: 0.2s;
        }

        input:focus {
            border-color: #777;
        }

        input.error-input {
            border-color: #d9534f;
        }

        .toggle-password {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            font-size: 13px;
            color: #666;
            user-select: none;
        }

        .error {
            color: #d9534f;
            font-size: 12px;
            margin-top: 6px;
            min-height: 15px;
        }

        .password-rules {
            margin-top: 8px;
            font-size: 12px;
            color: #777;
            line-height: 1.6;
        }

        button {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 10px;
            background: #222;
            color: white;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            margin-top: 8px;
        }

        button:hover {
            background: #000;
        }

        button:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .message {
            display: none;
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 18px;
            font-size: 13px;
        }

        .message.error-message {
            display: block;
            background: #fff0f0;
            color: #c0392b;
        }

        .login-link {
            text-align: center;
            margin-top: 20px;
            font-size: 13px;
            color: #777;
        }

        .login-link a {
            color: #222;
            font-weight: 600;
            text-decoration: none;
        }

        @media (max-width: 768px) {
            .container {
                flex-direction: column;
            }

            .image-section {
                width: 100%;
                height: 220px;
            }

            .form-section {
                width: 100%;
                padding: 35px 25px;
            }
        }
    </style>
</head>

<body>

<div class="container">

    <div class="image-section">
        <img src="/images/otp-verification.jpg" alt="KidLoop Kids">
    </div>

    <div class="form-section">

        <div class="brand">KidLoop</div>

        <h1 class="title">Reset Password</h1>

        <p class="subtitle">
            Create a new password for your KidLoop account.
        </p>

        <div id="message" class="message"></div>

        <form id="resetPasswordForm">

            <div class="form-group">
                <label for="newPassword">New Password</label>

                <div class="password-wrapper">
                    <input
                        type="password"
                        id="newPassword"
                        placeholder="Enter your new password"
                        autocomplete="new-password"
                    >

                    <span
                        class="toggle-password"
                        onclick="togglePassword('newPassword', this)"
                    >
                        Show
                    </span>
                </div>

                <div id="newPasswordError" class="error"></div>

                <div class="password-rules">
                    Password must contain at least 8 characters,
                    uppercase letter, lowercase letter, number and special character.
                </div>
            </div>


            <div class="form-group">

                <label for="confirmPassword">Confirm Password</label>

                <div class="password-wrapper">
                    <input
                        type="password"
                        id="confirmPassword"
                        placeholder="Confirm your new password"
                        autocomplete="new-password"
                    >

                    <span
                        class="toggle-password"
                        onclick="togglePassword('confirmPassword', this)"
                    >
                        Show
                    </span>
                </div>

                <div id="confirmPasswordError" class="error"></div>

            </div>


            <button type="submit" id="resetButton">
                Reset Password
            </button>

        </form>

        <div class="login-link">
            Remember your password?
            <a href="/auth/login">Login</a>
        </div>

    </div>

</div>


<script>

    const form = document.getElementById("resetPasswordForm");

    const newPassword = document.getElementById("newPassword");
    const confirmPassword = document.getElementById("confirmPassword");

    const newPasswordError = document.getElementById("newPasswordError");
    const confirmPasswordError = document.getElementById("confirmPasswordError");

    const message = document.getElementById("message");
    const resetButton = document.getElementById("resetButton");


    function togglePassword(inputId, element) {

        const input = document.getElementById(inputId);

        if (input.type === "password") {
            input.type = "text";
            element.textContent = "Hide";
        } else {
            input.type = "password";
            element.textContent = "Show";
        }
    }


    function showError(input, errorElement, text) {

        input.classList.add("error-input");
        errorElement.textContent = text;
    }


    function clearError(input, errorElement) {

        input.classList.remove("error-input");
        errorElement.textContent = "";
    }


    function validatePassword(password) {

        return /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&]).{8,}$/.test(password);
    }


    form.addEventListener("submit", async function (event) {

        event.preventDefault();

        clearError(newPassword, newPasswordError);
        clearError(confirmPassword, confirmPasswordError);

        message.className = "message";
        message.textContent = "";

        const password = newPassword.value;
        const confirm = confirmPassword.value;

        let valid = true;


        if (!password.trim()) {

            showError(
                newPassword,
                newPasswordError,
                "Please enter a new password."
            );

            valid = false;

        } else if (!validatePassword(password)) {

            showError(
                newPassword,
                newPasswordError,
                "Password does not meet the required conditions."
            );

            valid = false;
        }


        if (!confirm.trim()) {

            showError(
                confirmPassword,
                confirmPasswordError,
                "Please confirm your password."
            );

            valid = false;

        } else if (password !== confirm) {

            showError(
                confirmPassword,
                confirmPasswordError,
                "Passwords do not match."
            );

            valid = false;
        }


        if (!valid) {
            return;
        }


        const email = sessionStorage.getItem("forgotPasswordEmail");

        if (!email) {

            message.textContent =
                "Reset session expired. Please start the forgot password process again.";

            message.classList.add("error-message");

            return;
        }


        resetButton.disabled = true;
        resetButton.textContent = "Resetting...";


        try {

            const response = await fetch("/auth/reset-password", {

                method: "POST",

                headers: {
                    "Content-Type": "application/json"
                },

                body: JSON.stringify({
                    email: email,
                    newPassword: password,
                    confirmPassword: confirm
                })
            });


            const data = await response.json();


            if (!response.ok || !data.success) {

                message.textContent =
                    data.message || "Unable to reset password.";

                message.classList.add("error-message");

                resetButton.disabled = false;
                resetButton.textContent = "Reset Password";

                return;
            }


            // Reset completed successfully
            sessionStorage.removeItem("forgotPasswordEmail");

            window.location.href = "/auth/login";

        } catch (error) {

            console.error(error);

            message.textContent =
                "Something went wrong. Please try again.";

            message.classList.add("error-message");

            resetButton.disabled = false;
            resetButton.textContent = "Reset Password";
        }

    });

</script>

</body>
</html>